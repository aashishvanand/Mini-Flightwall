// Copy this file to secrets.h (gitignored) and fill in your real values.
#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Optional: base URL icons are synced from -- <base>/manifest.json and
// <base>/<name>.bin are fetched directly, no trailing slash, e.g.
// "https://data.airportdata.dev/24x24". Leave undefined (or empty) to skip
// remote icon sync entirely -- the SD card's preloaded icons/*.bin files
// still work as before. See README.md "Remote icon sync".
// #define ICON_BASE_URL "https://data.airportdata.dev/24x24"

// Optional: HTTP Basic Auth credentials gating the admin console's two
// highest-stakes actions -- POST /api/config and POST /api/ota (see
// README.md "OTA firmware updates"). Every other endpoint on this board
// stays unauthenticated, same LAN-only trust model as always; this is
// specifically about not letting a bad /api/ota push (or a hostname/
// timezone change) be a single unauthenticated request away. Leave
// undefined to use the fallback admin/changeme below -- fine for a
// private LAN, but change it if that's not acceptable for your network.
// #define ADMIN_USER "admin"
// #define ADMIN_PASSWORD "a real password, not this one"
