<script>
function fmtOffset(sec) {
  const sign = sec < 0 ? '-' : '+';
  const a = Math.abs(sec);
  const h = Math.floor(a / 3600);
  const m = Math.floor((a % 3600) / 60);
  return sign + h + ':' + (m < 10 ? '0' : '') + m;
}

let formHydrated = false;

