function deleteIcon(name) {
  if (!confirm('Delete ' + name + '? (frees memory now; removed from the SD card on next reboot)')) return;
  fetch('/api/icons/delete?name=' + encodeURIComponent(name), { method: 'POST' })
    .then(() => loadIcons());
